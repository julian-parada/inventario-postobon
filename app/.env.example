# Copie este archivo como ".env" y llene sus datos. El .env NO se sube a GitHub.

# ---- Opción A: PostgreSQL local (pgAdmin) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=su_contraseña_de_pgadmin
DB_NAME=postobon
DB_SSL=false

# ---- Opción B: Supabase ----
# Pegue la cadena "Session pooler" de Supabase (Connect > Session pooler) y active SSL.
# Si DATABASE_URL tiene valor, se usa en lugar de los datos de la opción A.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:SU_CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DB_SSL=true

DB_SCHEMA=inventario_postobon
PORT=3000

# ---- Acceso con contraseña (opcional, recomendado al publicarla en internet) ----
# APP_USUARIO=profesor
# APP_CLAVE=una_clave_para_compartir
